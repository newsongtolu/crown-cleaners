# Temporary files generated by text editor or operating system
/.bundle

# Ignore all environment files containing secrets
/.env*
!/.env.example

# Ignore all logfiles and tempfiles
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore uploaded assets and local storage
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore compiled public assets (precompiled on build)
/public/assets

# Ignore master key and decryption keys
/config/*.key

# Ignore local asset builds
/app/assets/builds/*
!/app/assets/builds/.keep

/vendor/bundle/vendor/
/vendor/
