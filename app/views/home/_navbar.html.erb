<header class="sticky top-0 z-50 bg-royal/95 backdrop-blur-md border-b border-gold/20 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Brand Logo (Dynamic Admin Setting via Global Helper) -->
    <a href="<%= root_path %>" class="flex items-center space-x-3 group">
      <% if @site_settings['logo_url'].present? %>
        <img src="<%= @site_settings['logo_url'] %>" alt="<%= @site_settings['company_name'] %>" class="h-10 w-auto object-contain">
      <% else %>
        <div class="w-10 h-10 rounded-xl bg-gold text-royal flex items-center justify-center shadow-lg group-hover:scale-105 transition-transform">
          <%= company_logo_icon("w-6 h-6", "currentColor") %>
        </div>
      <% end %>
      <div>
        <span class="text-base font-extrabold tracking-wider text-white block leading-tight">
          <%= @site_settings['company_name'] || "CROWN CLEANERS" %>
        </span>
        <span class="text-[10px] uppercase tracking-widest text-gold font-semibold">Leeds & West Yorkshire</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center space-x-8 text-xs font-semibold uppercase tracking-wider">
      <a href="<%= root_path %>#services" class="text-cream/80 hover:text-gold transition-colors">Services</a>
      <a href="<%= root_path %>#sectors" class="text-cream/80 hover:text-gold transition-colors">Sectors</a>
      <a href="<%= root_path %>#process" class="text-cream/80 hover:text-gold transition-colors">Our Process</a>
      <a href="<%= root_path %>#testimonials" class="text-cream/80 hover:text-gold transition-colors">Testimonials</a>
      <a href="<%= root_path %>#contact" class="text-cream/80 hover:text-gold transition-colors">Contact</a>
    </nav>

    <!-- Action CTA -->
    <div class="hidden lg:flex items-center space-x-6">
      <a href="tel:<%= @site_settings['phone'] || '08004962200' %>" class="text-xs font-bold text-gold hover:underline">
        <%= @site_settings['phone'] || '0800 496 2200' %>
      </a>
      <a href="#contact" class="bg-gold text-royal px-5 py-2.5 rounded-lg font-bold text-xs uppercase tracking-wider shadow-md hover:brightness-110 transition-all">
        Request a quote
      </a>
    </div>

    <!-- Mobile Menu Hamburger Button -->
    <button type="button" class="md:hidden text-cream hover:text-gold focus:outline-none p-2" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden bg-darkpurple border-b border-gold/20 px-6 pt-4 pb-8 space-y-4 shadow-2xl">
    <a href="<%= root_path %>#services" class="block text-cream hover:text-gold py-2 font-medium border-b border-cream/5">Services</a>
    <a href="<%= root_path %>#sectors" class="block text-cream hover:text-gold py-2 font-medium border-b border-cream/5">Sectors</a>
    <a href="<%= root_path %>#process" class="block text-cream hover:text-gold py-2 font-medium border-b border-cream/5">Our Process</a>
    <a href="<%= root_path %>#testimonials" class="block text-cream hover:text-gold py-2 font-medium border-b border-cream/5">Testimonials</a>
    <a href="#contact" class="block text-cream hover:text-gold py-2 font-medium">Contact</a>
    <div class="pt-4 border-t border-gold/20 flex flex-col space-y-3">
      <a href="tel:<%= @site_settings['phone'] || '08004962200' %>" class="text-sm text-gold font-semibold text-center">
        Call: <%= @site_settings['phone'] || '0800 496 2200' %>
      </a>
      <a href="#contact" class="bg-gold text-royal text-center py-3 rounded-lg font-bold shadow-md uppercase tracking-wider text-xs">
        Request a quote
      </a>
    </div>
  </div>
</header>