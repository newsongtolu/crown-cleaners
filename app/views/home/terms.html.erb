<%= render "navbar" %>

<main class="py-24 bg-cream text-royal min-h-screen">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    <div class="space-y-2">
      <span class="text-xs font-bold uppercase tracking-widest text-gold bg-royal px-3.5 py-1.5 rounded-full inline-block">COMMERCIAL TERMS</span>
      <h1 class="text-4xl sm:text-5xl font-serif text-royal pt-2">Terms of Service</h1>
    </div>

    <div class="space-y-6 text-sm text-royal/80 leading-relaxed bg-white p-8 sm:p-12 rounded-3xl border border-royal/10 shadow-sm">
      <p>By accessing or using the services of Crown Cleaners Limited, you agree to bound by these commercial terms operating across Leeds and West Yorkshire.</p>
      
      <h3 class="text-xl font-serif font-bold text-royal pt-4">1. Quotations & Site Surveys</h3>
