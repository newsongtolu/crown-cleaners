<%= form_with(model: [:admin, testimonial], local: true, class: "space-y-5 bg-white p-8 rounded-2xl border border-slate-200 shadow-sm") do |f| %>
  <% if testimonial.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-xl text-xs text-red-700 font-semibold mb-4 space-y-1">
      <p class="font-bold"><%= pluralize(testimonial.errors.count, "error") %> prohibited this testimonial from being saved:</p>
      <ul class="list-disc list-inside">
        <% testimonial.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <label class="block text-xs font-bold uppercase tracking-wider text-[#2E0F4A] mb-1.5">Client Quote</label>
    <%= f.text_area :quote, rows: 4, required: true, placeholder: "Enter client review or feedback...", class: "w-full bg-[#FAF7F2] border border-slate-300 rounded-xl p-3 text-xs text-slate-800 focus:outline-none focus:border-[#C9A227]" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <label class="block text-xs font-bold uppercase tracking-wider text-[#2E0F4A] mb-1.5">Author Role / Title</label>
      <%= f.text_field :author_title, placeholder: "e.g. Facilities Lead", required: true, class: "w-full bg-[#FAF7F2] border border-slate-300 rounded-xl p-3 text-xs text-slate-800 focus:outline-none focus:border-[#C9A227]" %>
    </div>
    <div>
      <label class="block text-xs font-bold uppercase tracking-wider text-[#2E0F4A] mb-1.5">Company / Location</label>
      <%= f.text_field :company_or_location, placeholder: "e.g. Care Setting, Leeds", required: true, class: "w-full bg-[#FAF7F2] border border-slate-300 rounded-xl p-3 text-xs text-slate-800 focus:outline-none focus:border-[#C9A227]" %>
    </div>
  </div>

  <div class="flex items-center space-x-3 pt-2">
    <%= f.check_box :active, class: "rounded border-slate-300 text-[#2E0F4A] focus:ring-[#C9A227] w-4 h-4" %>
    <label class="text-xs font-semibold text-slate-700">Active (Visible on Homepage)</label>
  </div>

  <div class="pt-4 flex items-center space-x-4">
    <%= f.submit testimonial.persisted? ? "Update Testimonial" : "Save Testimonial", class: "bg-[#2E0F4A] text-white px-6 py-3 rounded-xl font-bold text-xs uppercase tracking-wider shadow-md hover:bg-[#3B1A5C] transition-all cursor-pointer" %>
    <%= link_to "Cancel", admin_testimonials_path, class: "text-xs font-bold uppercase tracking-wider text-slate-500 hover:text-slate-800 hover:underline" %>
  </div>
<% end %>