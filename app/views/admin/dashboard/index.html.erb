<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard | Crown Cleaners Super Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            royal: '#2E0F4A',
            gold: '#C9A227',
            cream: '#F8F4EC',
            darkpurple: '#240A38',
            cardpurple: '#3B1A5C'
          }
        }
      }
    }
  </script>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
</head>
<body class="h-screen w-screen flex overflow-hidden bg-slate-100 font-sans antialiased text-slate-800 m-0 p-0">

  <!-- Collapsible Sidebar -->
  <aside class="group relative w-20 hover:w-72 bg-royal text-white flex flex-col shadow-2xl shrink-0 h-full transition-all duration-300 ease-in-out z-30">
    <div class="p-5 flex items-center space-x-3 border-b border-white/10 overflow-hidden shrink-0">
  <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-gold text-royal shadow-md shrink-0">
    <%= company_logo_icon("w-6 h-6", "currentColor") %>
  </div>
  <div class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap overflow-hidden">
    <h1 class="font-bold text-base tracking-wide text-white"><%= @site_settings['company_name'] rescue "Crown Cleaners" %></h1>
    <p class="text-xs text-gold font-semibold">Super Admin Portal</p>
  </div>
</div>

    <nav class="flex-1 px-3 py-6 space-y-2 text-sm overflow-hidden">
      <a href="/admin" class="flex items-center space-x-3 px-3.5 py-3 rounded-xl bg-white/10 text-white font-semibold transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
        </svg>
        <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">Dashboard</span>
      </a>

      <a href="/admin/services" class="flex items-center space-x-3 px-3.5 py-3 rounded-xl text-slate-300 hover:bg-white/5 hover:text-white transition-colors font-medium">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
        </svg>
        <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">Services Manager</span>
      </a>

      <a href="/admin/enquiries" class="flex items-center space-x-3 px-3.5 py-3 rounded-xl text-slate-300 hover:bg-white/5 hover:text-white transition-colors font-medium">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">Enquiries</span>
      </a>

      <a href="/admin/testimonials" class="flex items-center space-x-3 px-3.5 py-3 rounded-xl text-slate-300 hover:bg-white/5 hover:text-white transition-colors font-medium">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
        </svg>
        <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">Testimonials</span>
      </a>

      <a href="/admin/site_settings" class="flex items-center space-x-3 px-3.5 py-3 rounded-xl text-slate-300 hover:bg-white/5 hover:text-white transition-colors font-medium">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-slate-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">Site Settings</span>
      </a>
    </nav>

    <div class="p-3 border-t border-white/10 overflow-hidden shrink-0">
      <%= button_to admin_logout_path, method: :delete, class: "w-full flex items-center justify-center space-x-2 px-3 py-2.5 rounded-xl bg-red-600/20 hover:bg-red-600 text-red-300 hover:text-white transition-all text-sm font-semibold cursor-pointer" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
        </svg>
        <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap">Sign Out</span>
      <% end %>
    </div>
  </aside>

  <!-- Main Content Wrapper -->
  <div class="flex-1 flex flex-col h-full overflow-hidden bg-slate-100">
    <header class="bg-white shadow-sm border-b border-slate-200 h-16 flex items-center justify-between px-8 z-10 shrink-0">
      <div class="flex items-center space-x-3">
        <span class="text-xs uppercase tracking-wider bg-royal/10 text-royal px-3 py-1 rounded-full font-extrabold">Active Session</span>
        <span class="text-sm font-semibold text-slate-600">Leeds & West Yorkshire Region</span>
      </div>
      <div class="flex items-center space-x-4">
        <span class="text-sm font-bold text-slate-700"><%= current_admin_user.email %></span>
        <div class="w-10 h-10 rounded-full bg-royal text-gold flex items-center justify-center font-bold shadow-md ring-2 ring-gold/30">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
          </svg>
        </div>
      </div>
    </header>

    <main class="flex-1 overflow-y-auto p-6 lg:p-8">
      <div class="w-full space-y-8 max-w-7xl mx-auto">
        
        <!-- Welcome Banner -->
        <div class="bg-[#2E0F4A] rounded-2xl p-8 text-white shadow-xl relative overflow-hidden flex flex-col md:flex-row justify-between items-start md:items-center border border-[#C9A227]/30">
          <div class="space-y-2 z-10">
            <span class="text-xs font-bold uppercase tracking-widest text-[#C9A227]">CENTRAL COMMAND CONSOLE</span>
            <h2 class="text-3xl font-extrabold tracking-tight text-white">Welcome back, Super Admin!</h2>
            <p class="text-[#F8F4EC]/90 text-sm max-w-xl font-light leading-relaxed">
              Manage your commercial cleaning bookings, client enquiries, core company service parameters, and testimonials across West Yorkshire from your central management console.
            </p>
          </div>
          <div class="mt-6 md:mt-0 z-10">
            <a href="/" target="_blank" class="inline-flex items-center space-x-2 bg-[#C9A227] hover:brightness-110 text-[#2E0F4A] font-bold px-6 py-3.5 rounded-xl shadow-lg transition-all text-xs uppercase tracking-wider">
              <span>View Live Website</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </div>
          <!-- Decorative Background Circle -->
          <div class="absolute -right-10 -bottom-10 w-64 h-64 rounded-full bg-white/5 pointer-events-none"></div>
        </div>

        <!-- Metric Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <!-- Card 1: Services -->
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex items-center space-x-5">
            <div class="w-14 h-14 rounded-xl bg-purple-100 text-royal flex items-center justify-center shadow-inner shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Active Services</p>
              <h3 class="text-3xl font-extrabold text-slate-900 mt-1"><%= @services_count rescue 6 %></h3>
              <p class="text-xs text-emerald-600 font-semibold mt-1">✓ Fully online</p>
            </div>
          </div>

          <!-- Card 2: Enquiries -->
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex items-center space-x-5">
            <div class="w-14 h-14 rounded-xl bg-amber-100 text-gold flex items-center justify-center shadow-inner shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Client Enquiries</p>
              <h3 class="text-3xl font-extrabold text-slate-900 mt-1"><%= @enquiries_count rescue 0 %></h3>
              <p class="text-xs text-slate-500 font-semibold mt-1">Total leads received</p>
            </div>
          </div>

          <!-- Card 3: Testimonials -->
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex items-center space-x-5">
            <div class="w-14 h-14 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center shadow-inner shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Testimonials</p>
              <h3 class="text-3xl font-extrabold text-slate-900 mt-1"><%= Testimonial.count rescue 3 %></h3>
              <p class="text-xs text-emerald-600 font-semibold mt-1">Active client reviews</p>
            </div>
          </div>

          <!-- Card 4: Site Settings -->
          <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex items-center space-x-5">
            <div class="w-14 h-14 rounded-xl bg-blue-100 text-blue-800 flex items-center justify-center shadow-inner shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Site Settings</p>
              <h3 class="text-3xl font-extrabold text-slate-900 mt-1"><%= @site_settings_count rescue 10 %></h3>
              <p class="text-xs text-emerald-600 font-semibold mt-1">Configured params</p>
            </div>
          </div>

        </div>

        <!-- Recent Enquiries Section -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-bold text-slate-900">Recent Customer Enquiries</h3>
            <a href="/admin/enquiries" class="text-xs font-bold text-royal hover:underline uppercase tracking-wider">View All Enquiries &rarr;</a>
          </div>

          <% if defined?(@recent_enquiries) && @recent_enquiries.any? %>
            <div class="divide-y divide-slate-100">
              <% @recent_enquiries.each do |enquiry| %>
                <div class="py-4 flex items-center justify-between">
                  <div>
                    <h4 class="text-sm font-bold text-slate-800"><%= enquiry.name %> (<%= enquiry.organization.presence || "Direct Enquiry" %>)</h4>
                    <p class="text-xs text-slate-500"><%= enquiry.service_type %> &middot; <%= enquiry.email %> &middot; <%= enquiry.phone %></p>
                  </div>
                  <span class="text-xs text-slate-400"><%= time_ago_in_words(enquiry.created_at) %> ago</span>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-12 border-2 border-dashed border-slate-200 rounded-xl">
              <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 flex items-center justify-center text-slate-400 mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                </svg>
              </div>
              <p class="text-sm font-bold text-slate-700">No enquiries received yet</p>
              <p class="text-xs text-slate-500 mt-1">New client booking submissions from the public website will appear here instantly.</p>
            </div>
          <% end %>
        </div>

      </div>
    </main>
  </div>

</body>
</html>